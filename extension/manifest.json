{
  "manifest_version": 3,
  "name": "BEOMCHRO 0ms Ultra Queue Interceptor",
  "version": "2.1.0",
  "description": "NOL 티켓 & 인터파크 티켓 게이트 0ms 초고속 대기열 자동 진입 엔진 (ON/OFF 컨트롤 & 실시간 조준 표시)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*",
        "*://nol.yanolja.com/*",
        "*://*.yanolja.com/*",
        "*://ticket.nol.com/*",
        "*://*.nol.com/*",
        "*://tickets.interpark.com/*",
        "*://ticket.interpark.com/*",
        "*://*.interpark.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "BEOMCHRO 0ms Interceptor v2.1"
  }
}
