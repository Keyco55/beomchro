{
  "manifest_version": 3,
  "name": "BEOMCHRO 0ms Ultra Queue Interceptor",
  "version": "2.0.0",
  "description": "놀티켓 & 로컬 시뮬레이터 0ms 초고속 대기열 자동 진입 엔진 (Zero-Setup)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://ticket.nol.com/*",
        "*://*.nol.com/*",
        "*://ticket.interpark.com/*",
        "*://*.interpark.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "BEOMCHRO 0ms Interceptor Active"
  }
}
